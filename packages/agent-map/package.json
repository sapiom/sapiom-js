{
  "name": "@sapiom/agent-map",
  "version": "0.1.0",
  "description": "Shared Agent Map contracts and local project persistence.",
  "type": "module",
  "license": "MIT",
  "author": "Sapiom",
  "repository": {
    "type": "git",
    "url": "https://github.com/sapiom/sapiom-js.git",
    "directory": "packages/agent-map"
  },
  "main": "./dist/shared/agent-map.js",
  "types": "./dist/shared/agent-map.d.ts",
  "exports": {
    ".": {
      "types": "./dist/shared/agent-map.d.ts",
      "import": "./dist/shared/agent-map.js"
    },
    "./project-id": {
      "types": "./dist/shared/project-id.d.ts",
      "import": "./dist/shared/project-id.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "typescript": "~5.9.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
