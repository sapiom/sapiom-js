{
  "name": "@sapiom/harness-desktop",
  "version": "0.1.5",
  "private": true,
  "description": "Agent Studio desktop app — a native workspace for building, testing, deploying, and running Sapiom agents with Claude Code or Codex.",
  "homepage": "https://sapiom.ai",
  "author": {
    "name": "Sapiom",
    "email": "team@sapiom.ai"
  },
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-renderer.mjs",
    "dev": "pnpm run build && electron . --dev",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dist": "pnpm run build && node scripts/pack.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@sapiom/harness": "workspace:^",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "npm": "^10.9.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@electron/rebuild": "^3.7.0",
    "@types/node": "^20.11.30",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.4.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
