{
  "name": "@sapiom/browser-pay",
  "version": "0.0.0",
  "description": "Browser-side payment interceptor. Pause a placeholder card request over CDP and relay it.",
  "keywords": [
    "sapiom",
    "sdk",
    "payments",
    "cdp",
    "checkout"
  ],
  "homepage": "https://github.com/sapiom/sapiom-js/tree/main/packages/browser-pay#readme",
  "bugs": {
    "url": "https://github.com/sapiom/sapiom-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sapiom/sapiom-js.git",
    "directory": "packages/browser-pay"
  },
  "license": "MIT",
  "author": "Sapiom",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./testing": {
      "types": "./dist/cjs/testing.d.ts",
      "import": "./dist/esm/testing.js",
      "require": "./dist/cjs/testing.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:esm-pkg",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build:esm": "tsc --project tsconfig.esm.json",
    "build:esm-pkg": "node -e \"require('fs').writeFileSync('dist/esm/package.json',JSON.stringify({type:'module'}))\"",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsc --watch --project tsconfig.cjs.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.examples.json",
    "lint": "eslint src examples --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"examples/**/*.ts\"",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@sapiom/tools": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "playwright": "^1.61.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "tsx": "^4.20.3",
    "typescript": "^5.4.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
