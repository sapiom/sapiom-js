{
  "fleetVersion": 1,
  "id": "sylon",
  "resources": [
    {
      "kind": "postgres",
      "handle": "sylon",
      "migrations": "_shared/migrations"
    }
  ],
  "connectors": [
    {
      "provider": "slack",
      "requiredBy": [
        "intake",
        "copilot",
        "escalation",
        "controller",
        "urgent-pager",
        "linear-sync",
        "watchdog"
      ]
    },
    {
      "provider": "linear",
      "relaySlug": "linear",
      "discover": true,
      "requiredBy": ["escalation", "linear-sync"]
    }
  ],
  "projects": [
    { "key": "intake", "path": "agents/intake", "slug": "sylon-intake" },
    { "key": "copilot", "path": "agents/copilot", "slug": "sylon-copilot" },
    {
      "key": "escalation",
      "path": "agents/escalation",
      "slug": "sylon-escalation"
    },
    {
      "key": "controller",
      "path": "agents/controller",
      "slug": "sylon-controller"
    },
    {
      "key": "linear-sync",
      "path": "agents/linear-sync",
      "slug": "sylon-linear-sync"
    },
    {
      "key": "urgent-pager",
      "path": "agents/urgent-pager",
      "slug": "sylon-urgent-pager",
      "optional": true
    },
    {
      "key": "watchdog",
      "path": "agents/watchdog",
      "slug": "sylon-watchdog"
    },
    {
      "key": "smoke-ingest",
      "path": "agents/smoke-ingest",
      "slug": "sylon-smoke-ingest",
      "smoke": true
    },
    {
      "key": "smoke-consume",
      "path": "agents/smoke-consume",
      "slug": "sylon-smoke-consume",
      "smoke": true
    }
  ],
  "triggers": [
    {
      "project": "intake",
      "kind": "event",
      "eventType": "slack.message.created"
    },
    {
      "project": "intake",
      "kind": "event",
      "eventType": "slack.reaction_added"
    },
    {
      "project": "intake",
      "kind": "event",
      "eventType": "slack.block_actions"
    },
    { "project": "copilot", "kind": "event", "eventType": "issue.created" },
    {
      "project": "copilot",
      "kind": "event",
      "eventType": "issue.message_added"
    },
    {
      "project": "copilot",
      "kind": "event",
      "eventType": "slack.block_actions"
    },
    { "project": "escalation", "kind": "event", "eventType": "issue.escalate" },
    { "project": "controller", "kind": "schedule_cron", "cron": "*/2 * * * *" },
    {
      "project": "linear-sync",
      "kind": "schedule_cron",
      "cron": "*/2 * * * *"
    },
    {
      "project": "urgent-pager",
      "kind": "event",
      "eventType": "issue.created"
    },
    { "project": "watchdog", "kind": "schedule_cron", "cron": "*/5 * * * *" }
  ],
  "smokeTriggers": [
    {
      "project": "smoke-ingest",
      "kind": "event",
      "eventType": "slack.message.created"
    },
    {
      "project": "smoke-consume",
      "kind": "event",
      "eventType": "issue.created"
    }
  ],
  "desks": [
    {
      "slug": "support",
      "name": "Support",
      "triageChannel": "C0TRIAGE001",
      "linearTeamId": "example-linear-team-id",
      "linearProjectId": "example-linear-project-id",
      "oncallSlackId": "U0ONCALL001",
      "nudgeMinutes": 5,
      "default": true
    }
  ],
  "config": {
    "channels.customer": [
      { "channelId": "C0CUSTOMER1", "accountName": "Example Customer" }
    ],
    "customers.test_user_ids": [],
    "intake.reactions": true,
    "linear_sync.notify_customer": false
  }
}
